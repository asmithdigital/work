---
import { Image } from 'astro:assets';
import fl_f1a from '../assets/images/freelance-1a.png';
import fl_f1b from '../assets/images/freelance-1b.png';
import fl_f1c from '../assets/images/freelance-1c.png';
import fl_f2a from '../assets/images/freelance-2a.png';
import fl_f2b from '../assets/images/freelance-2b.png';
import fl_f3a from '../assets/images/freelance-3a.png';
import fl_f3b from '../assets/images/freelance-3b.png';
import fl_f4a from '../assets/images/freelance-4a.png';
---
<section class="chapter" id="freelance"><header class="chapter-head"><p class="chapter-no">+</p><h2>Freelance &amp; graphic design</h2><p class="claim">20 years of client work. Designed, built, and shipped.</p><p class="lede">A sample from two decades of freelance web design and development. Small businesses, e-commerce, service providers, each project managed end to end, from brief through to live site.</p></header><div class="meta-strip">
        <div class="meta-item"><p class="meta-label">Clients</p><p class="meta-value">Small business, e-commerce, services</p></div>
        <div class="meta-item"><p class="meta-label">Role</p><p class="meta-value">Designer & Developer</p></div>
        <div class="meta-item"><p class="meta-label">Period</p><p class="meta-value">2004 – present</p></div>
      </div><div class="editorial-section">
        <div class="section-rail"><p class="section-kicker">PALI Footwear</p></div>
        <div class="story-block"><p>Shopify e-commerce site for an Australian wool footwear brand. Custom theme, product catalogue, and checkout flow, designed to reflect the brand's focus on natural materials and ethical production.</p></div>
      </div><div class="freelance-grid">
        <Image class="freelance-img" src={fl_f1a} alt="PALI Footwear homepage" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
        <Image class="freelance-img" src={fl_f1b} alt="PALI Footwear products page" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
        <Image class="freelance-img" src={fl_f1c} alt="PALI Footwear product detail page" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
      </div><div class="editorial-section">
        <div class="section-rail"><p class="section-kicker">Chaircovers Over All</p></div>
        <div class="story-block"><p>WooCommerce catalogue site for an event hire business with over 600 products across table linen, chair covers, centrepieces, and tableware. Custom category navigation, product filtering, and an enquiry basket flow.</p></div>
      </div><div class="freelance-grid">
        <Image class="freelance-img" src={fl_f2a} alt="Chaircovers Over All homepage" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
        <Image class="freelance-img" src={fl_f2b} alt="Chaircovers Over All products page" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
        <Image class="freelance-img" src={fl_f4a} alt="Bass Coast Podiatry homepage" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
      </div><div class="editorial-section">
        <div class="section-rail"><p class="section-kicker">Graceful Grounded Yoga</p></div>
        <div class="story-block"><p>Boutique yoga studio website for a Melbourne instructor. Booking integration, class schedule, and about page, designed to feel warm and personal rather than corporate.</p></div>
      </div><div class="freelance-grid">
        <Image class="freelance-img" src={fl_f3a} alt="Graceful Grounded Yoga about page" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
        <Image class="freelance-img" src={fl_f3b} alt="Graceful Grounded Yoga section" loading="lazy" decoding="async" widths={[600,900]} sizes="33vw"/>
        <div class="freelance-placeholder"><p>[ More screenshots coming ]</p></div>
      </div></section>
