---
const { items } = Astro.props;
---
<nav class="toc" aria-label="On this page">
  {items.map((c) => (
    <div class="ch">
      <a href={'#' + c.id}>{c.title}</a>
      <div class="subs">{c.subs.map((s) => <a href={'#' + s.id}>{s.title}</a>)}</div>
    </div>
  ))}
</nav>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const targets = links.map((a) => document.getElementById(a.hash.slice(1)));
  let busy = false;
  function spy() {
    busy = false;
    let cur = 0;
    targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top <= 150) cur = i; });
    links.forEach((l) => l.classList.remove('active'));
    document.querySelectorAll('.toc .ch').forEach((c) => c.classList.remove('open'));
    links[cur].classList.add('active');
    links[cur].closest('.ch')?.classList.add('open');
  }
  addEventListener('scroll', () => { if (!busy) { busy = true; requestAnimationFrame(spy); } }, { passive: true });
  spy();
</script>
