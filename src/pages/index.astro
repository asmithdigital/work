---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Andrew Smith | Digital UX and Product Designer" description="Andrew Smith, digital UX and product designer in Adelaide. Case studies from RAA Travel, member products and identity management, plus freelance work.">
  <main>
    <section class="intro">
      <h1>Andrew Smith</h1>
      <p class="role-line">Digital UX and product designer</p>
      <p class="bio">I design the digital products people use to book, buy, claim and sign in, working in product squads alongside product managers and engineers. I run the research, workshops and testing that lead to the right solution, and see the work through to delivery. Most recently I also led the UX team at RAA while continuing to design.</p>
    </section>
    {projects.map((p) => (
      <a class="card" href={`${base}/${p.slug}`}>
        <div class="thumb"><Image src={p.hero} alt={p.heroAlt} widths={[600, 900]} sizes="(max-width: 820px) 100vw, 600px" /></div>
        <div>
          <span class="label">{p.label}</span>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>
          <span class="more">Read case study &rarr;</span>
        </div>
      </a>
    ))}
  </main>
</Base>
