---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Image } from 'astro:assets';
import '../styles/portfolio.css';
import qtb from '../assets/images/raa-qtb-start.png';
import ds from '../assets/images/design-system-2.png';
---
<Layout title="Andrew Smith | Product Designer & Front-End Developer" description="Andrew Smith, product designer and front-end developer in Adelaide. Twenty years from hand-coded websites to design systems and complex digital products." showFooterCta={true}>
<a class="skip-link" href="#main-content">Skip to content</a>
<SiteHeader />
<main id="main-content" class="home">
  <p class="eyebrow">Product designer &amp; front-end developer</p>
  <h1>Hi, I'm Andrew. A product designer who started in code.</h1>
  <p class="hero-lede">Twenty years building for the web, first as a front-end developer, then as a product designer inside Agile product teams. I design complex digital products, build design systems in code, and still write code today to prototype quickly.</p>
  <ul class="facts"><li>Adelaide, South Australia</li><li>20 years</li><li>Currently studying product management</li></ul>
  <div class="tiles">
    <a class="tile" href="/work/design"><Image src={qtb} alt="Quote to buy" /><div><h2>Design</h2><p>UX and product process, workshops and sprints, journey mapping, benchmarking, UI design and design systems.</p></div></a>
    <a class="tile" href="/work/development"><Image src={ds} alt="Design system" /><div><h2>Development</h2><p>Hand-coded sites, a university design system, design systems in code and AI-assisted prototyping.</p></div></a>
  </div>
  <p class="lede" style="margin-top:32px">Freelance and graphic design work sits at the bottom of both pages. <a href="/work/resume">View my resume</a>.</p>
</main>
</Layout>
