---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/case-study.css";
---
<Layout title="Resume | Andrew Smith" description="Resume of Andrew Smith, product designer and front-end developer." showFooterCta={true}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="case-page">
    <SiteHeader />
    <main id="main-content">
      <section class="case-hero">
        <p class="eyebrow"><a class="breadcrumb-link" href="/work/">Home</a><span class="breadcrumb-separator">/</span><span>Resume</span></p>
        <h1 class="display-title">Developer, then designer, then leader.</h1>
        <p class="hero-text">Twenty years from hand-coded websites to product design in Agile squads. Currently studying product management.</p>
        <p class="hero-subtext"><a href="/work/Andrew_Smith_Resume.docx">Download resume (Word)</a> &nbsp;·&nbsp; asmithdigital@gmail.com</p>
      </section>
      <section class="content-section"><div class="section-content">
        <p class="section-kicker">2019 – present</p><h2>Senior UX Design Lead &amp; Manager, Digital UX — RAA</h2>
        <p>Lead product design across travel, insurance, payments and member services in Agile squads, run discovery and design sprints, prototype in code, and built research operations, journey mapping and design system governance. Since 2025, also manage the UX team.</p>
        <p class="section-kicker">2014 – 2019</p><h2>Lead Web Designer, Senior UX Designer &amp; Front-End Developer — University of Adelaide</h2>
        <p>Designed and built the university's websites and portals, introduced UX practice and built a JavaScript design system adopted across all development teams.</p>
        <p class="section-kicker">Earlier career</p><h2>Viterra · Private Media · Vmedia · asmithdigital · Tower Hotel</h2>
        <p>Web design, front-end development, digital production and client management from 1999, plus freelance design and development since 2004.</p>
        <p class="section-kicker">Study</p><h2>Product Management · Applied Project Management (Grad. Cert., in progress)</h2>
        <p>Also: Certificate in User Experience (Nielsen Norman Group), Human Centred Design, User Experience and Usability, Multimedia Studies (Bachelor, University of South Australia).</p>
      </div></section>
    </main>
  </div>
</Layout>
